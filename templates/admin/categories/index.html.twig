{% extends "basefront.html.twig" %}

{% block body %}

<h3 class="mt-3">Gestion des catégories</h3>

<!-- Mini formulaire -->
<form method="post" action="{{ path('admin.categories.add') }}" class="mb-3">
    <input type="text" name="name" placeholder="Nouvelle catégorie" required>
    <button type="submit" class="btn btn-primary btn-sm">Ajouter</button>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Nb formations</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        {% for categorie in categories %}
            <tr>
                <td>{{ categorie.name }}</td>

                <td>{{ categorie.formations|length }}</td>

                <td>
                    {% if categorie.formations|length == 0 %}
                        <a href="{{ path('admin.categories.delete', {id: categorie.id}) }}"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Supprimer cette catégorie ?');">
                            Supprimer
                        </a>
                    {% else %}
                        ❌ utilisée
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

{% endblock %}